{
  "manifest_version": 3,
  "name": "__MSG_extension_name__",
  "version": "3.0.0",
  "description": "__MSG_extension_description__",
  "default_locale": "fr",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "Ouvrir ErgoVision AI"
  },
  "sidebar_action": {
    "default_panel": "index.html",
    "default_title": "ErgoVision AI — Studio Postural",
    "default_icon": "assets/icons/icon-48.png",
    "open_at_install": true
  },
  "background": {
    "scripts": ["src/extension/background.js"],
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ergovision-ai@ergovision.app",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self';"
  }
}
