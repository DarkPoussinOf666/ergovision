{
  "manifest_version": 3,
  "name": "ErgoVision AI — Posture & Back Physio Guardian",
  "version": "3.0.0",
  "description": "Copilote biomécanique temps réel 100% local prévenant les TMS, l'affaissement cervical et guidant les étirements kiné au poste de travail.",
  "default_locale": "fr",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "Ouvrir ErgoVision AI"
  },
  "sidebar_action": {
    "default_panel": "index.html",
    "default_title": "ErgoVision AI — Studio Postural",
    "default_icon": "assets/icons/icon-48.png",
    "open_at_install": true
  },
  "background": {
    "scripts": ["src/extension/background.js"],
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ergovision-ai@ergovision.app",
      "strict_min_version": "115.0"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https://api.lemonsqueezy.com;"
  }
}
